# My Fitness Journal environment template. Copy to .env and fill in; see README "Environment" and
# "Deploying / self-hosting". Values here are production-safe placeholders: anything marked
# CHANGE_ME must be replaced (openssl rand -hex 32), and the app refuses to boot in production
# with Inngest dev mode or default Inngest keys.

# --- Core (required) ---
# The app's own connection. compose.prod.yml builds this itself (least-privilege APP_DB_USER role);
# set it here for `bun dev`, drizzle-kit and the admin CLI. Host: localhost on the host, postgres in compose.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/app
# Seals the session cookie; 32+ characters. Changing it signs everyone out.
NUXT_SESSION_PASSWORD=CHANGE_ME_64_HEX_CHARS
# Session lifetime in seconds from sign-in (default 30 days).
# NUXT_SESSION_MAX_AGE=2592000

# --- Accounts ---
# 'open' lets anyone sign up; anything else (e.g. 'closed') allows only the first account, which becomes the admin.
# Register your own account first, then set this to closed.
NUXT_REGISTRATION=closed
# 'true' only behind a reverse proxy you control: client IP / host are then read from X-Forwarded-For / -Host.
NUXT_TRUST_PROXY=false
# Display name.
APP_NAME="My Fitness Journal"
# HTTP port of the built server (the compose app service always listens on 3000 inside the container).
# PORT=3000

# --- Compose services (compose.yml uses dev defaults; compose.prod.yml requires these) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=app
# compose.prod.yml only: the app's non-superuser database role, created and granted by the migrate service.
APP_DB_USER=journal
APP_DB_PASSWORD=CHANGE_ME
INNGEST_SCHEMA=inngest
# compose.prod.yml only: Redis requirepass and Meilisearch master key (Meilisearch needs 16+ bytes).
REDIS_PASSWORD=CHANGE_ME
MEILI_MASTER_KEY=CHANGE_ME
# compose.prod.yml only: host interface and port the app is published on (put your HTTPS proxy in front).
# APP_BIND=127.0.0.1
# APP_PORT=3000
# INNGEST_UI_PORT=8288
# Redis URL the dev compose.yml hands to Inngest (compose.prod.yml builds its own).
# REDIS_URL=redis://redis:6379

# --- Inngest (background jobs) ---
# Hex strings, even length, 32+ characters: openssl rand -hex 32. Shared by the app and the inngest service.
INNGEST_SIGNING_KEY=CHANGE_ME_64_HEX_CHARS
INNGEST_EVENT_KEY=CHANGE_ME_64_HEX_CHARS
# Where the SDK reaches Inngest, and the URL Inngest calls back. compose.prod.yml sets both for you.
# INNGEST_BASE_URL=http://inngest:8288
# INNGEST_SERVE_ORIGIN=http://app:3000

# --- Search and cache ---
# Unset NUXT_MEILI_HOST forces the Postgres fallback. compose.prod.yml sets both (key = MEILI_MASTER_KEY).
# NUXT_MEILI_HOST=http://localhost:7700
# NUXT_MEILI_API_KEY=
# Cache store; unset uses Nitro's in-memory cache. Include the password: redis://:<password>@host:6379/1
# NUXT_REDIS_URL=

# --- Sign-in providers (optional) ---
# GitHub callback <origin>/api/auth/github; Google redirect <origin>/api/auth/google (also used by Google Health).
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# --- Food sources (optional) ---
# Open Food Facts requires an app name and a contact.
NUXT_OFF_USER_AGENT="MyFitnessJournal/0.1 (you@example.com)"
# https://fdc.nal.usda.gov/api-key-signup — DEMO_KEY works at 30 req/h.
NUXT_USDA_API_KEY=DEMO_KEY
# FatSecret Platform; the server's public IP must be on the app's allow-list.
NUXT_FATSECRET_CLIENT_ID=
NUXT_FATSECRET_CLIENT_SECRET=
NUXT_FATSECRET_SCOPE=basic

# --- Google Health (optional) ---
# Add <origin>/api/integrations/google-health/connect to the Google client's redirect URIs.
# 32 random bytes, base64: openssl rand -base64 32. Changing it forces every user to reconnect.
NUXT_GOOGLE_HEALTH_TOKEN_KEY=
# Scheduled sync (Inngest cron, optional TZ= prefix); changing it needs a restart.
NUXT_GOOGLE_HEALTH_SYNC_CRON="TZ=America/Chicago 0 7,15 * * *"
# Minimum seconds between a user's "Sync now" presses (default 60).
# NUXT_GOOGLE_HEALTH_SYNC_COOLDOWN_SECONDS=60

# --- Sentry (optional) ---
# Runtime reporting is off unless set. The client DSN is read at build time; override at runtime with NUXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Build-time only, for source map upload; upload happens only when SENTRY_UPLOAD_SOURCEMAPS=true.
SENTRY_UPLOAD_SOURCEMAPS=false
# SENTRY_ORG=
# SENTRY_PROJECT=my-fitness-journal
# SENTRY_AUTH_TOKEN=

# --- Metrics and logging (optional) ---
ENABLE_OPENTELEMETRY=false
# OTEL_SERVICE_NAME=my-fitness-journal-server
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LOG_LEVEL=info
# Extra JSON log file next to stdout; empty for stdout only (compose.prod.yml sets it empty).
# LOG_FILE=logs/app.log
# GIT_SHA=
# Alloy (dev compose.yml) remote-write targets.
# MIMIR_PUSH_URL=
# LOKI_PUSH_URL=

# --- Development only: never set these in production ---
# INNGEST_DEV=1 turns off Inngest request signing; with it, the dev Inngest container and the compose.yml default
# keys (deadbeefdeadbeef / cafebabecafebabe) work. A production build refuses to start with it set.
# INNGEST_DEV=1
# INNGEST_BASE_URL=http://localhost:8288
# INNGEST_SERVE_ORIGIN=http://host.docker.internal:3000
# INNGEST_EVENT_KEY=deadbeefdeadbeef
# INNGEST_SIGNING_KEY=cafebabecafebabe
# NUXT_MEILI_HOST=http://localhost:7700
# NUXT_REDIS_URL=redis://localhost:6379
# NUXT_TEST_FIXTURES=1 is set by playwright.config.ts for e2e builds only. Setting it anywhere else compiles in and
# enables unauthenticated test routes and skips the production Inngest check. Never set it yourself.
