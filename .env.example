# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis
REDIS_URL=redis://redis:6379

# Inngest (must be hex strings with even number of chars)
INNGEST_EVENT_KEY=deadbeefdeadbeef
INNGEST_SIGNING_KEY=cafebabecafebabe
INNGEST_BASE_URL=http://inngest:8288
INNGEST_SCHEMA=inngest

# App
PORT=3000
NUXT_SESSION_PASSWORD=password-with-at-least-32-characters

# Optional
APP_NAME = "My Fitness Journal"

# --- OpenTelemetry (optional, off by default) ---
# Master switch. When true: starts the server trace SDK and enables browser
# tracing. Requires the local `alloy` collector (see compose.yml) running and
# reachable, plus a downstream LGTM/Tempo+Loki stack. Leave false to disable.
ENABLE_OPENTELEMETRY=false
# The settings below only take effect when ENABLE_OPENTELEMETRY=true:
OTEL_SERVICE_NAME=my-fitness-journal-server
OTEL_RESOURCE_ATTRIBUTES=service.namespace=homelab,deployment.environment=dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Logs ship via file→Alloy and metrics come from Tempo's generator, so disable
# OTLP metric/log export to avoid connection-refused noise.
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
LOG_LEVEL=info
# Where the local Alloy collector forwards to:
# Tempo is a bare host:port (OTLP
TEMPO_OTLP_ENDPOINT=127.0.0.1:44317
# Loki is a full push URL.
LOKI_PUSH_URL=http://127.0.0.1:43100/loki/api/v1/push
