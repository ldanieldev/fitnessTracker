table app.auth_providers {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  user_id integer [not null]
  provider varchar(50) [not null]
  provider_account_id varchar(255) [not null]

  indexes {
    (provider, provider_account_id) [name: 'auth_providers_provider_account_unique', unique]
  }
}

table app.body_parts {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  name varchar(255) [not null]
  image_url varchar(255) [default: `null`]

  indexes {
    name [name: 'body_part_name', unique]
  }
}

table app.diary_day_targets {
  day_id integer [not null]
  nutrient_id integer [not null]
  amount numeric [not null]
  direction varchar [not null]

  indexes {
    (day_id, nutrient_id) [pk]
  }
}

table app.diary_days {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  user_id integer [not null]
  date date [not null]
  notes text [default: `null`]
  goal_profile_id integer [default: `null`]

  indexes {
    (user_id, date) [name: 'diary_day_user_date_unique', unique]
  }
}

table app.diary_entries {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  day_id integer [not null]
  container_id integer [not null]
  sort_order integer [not null]
  logged_at timestamp [not null, default: `now()`]
  entry_type varchar [not null]
  food_id integer [default: `null`]
  food_serving_id integer [default: `null`]
  recipe_id integer [default: `null`]
  quantity numeric [not null]
  unit_label varchar(64) [not null]
  grams_resolved numeric [default: `null`]
  description varchar(255) [default: `null`]
  brand_snapshot varchar(255) [default: `null`]
  ingredient_snapshot jsonb [default: `null`]
  notes text [default: `null`]
  import_key varchar(64) [default: `null`]

  indexes {
    
    (day_id, container_id, sort_order) [name: 'diary_entry_day_container_order']
    import_key [name: 'diary_entry_import_key_unique', unique]
  }
}

table app.diary_entry_nutrients {
  entry_id integer [not null]
  nutrient_id integer [not null]
  amount numeric [not null]

  indexes {
    (entry_id, nutrient_id) [pk]
  }
}

table app.diary_meal_times {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  day_id integer [not null]
  container_id integer [not null]
  time varchar(5) [not null]

  indexes {
    (day_id, container_id) [name: 'diary_meal_time_day_container_unique', unique]
  }
}

table app.equipment {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  name varchar(255) [not null]

  indexes {
    name [name: 'equipment_name', unique]
  }
}

table app.exercise_equipment {
  exercise_id integer [not null]
  equipment_id integer [not null]

  indexes {
    (exercise_id, equipment_id) [pk]
  }
}

table app.exercise_muscles {
  exercise_id integer [not null]
  muscle_id integer [not null]
  is_primary boolean [not null, default: true]

  indexes {
    (exercise_id, muscle_id) [pk]
  }
}

table app.exercise_types {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  name varchar(255) [not null]

  indexes {
    name [name: 'exercise_type_name', unique]
  }
}

table app.exercises {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  name varchar(255) [not null]
  exercise_type_id integer [default: `null`]
  difficulty varchar [default: `null`]
  image_url varchar(255) [default: `null`]
  video_url varchar(255) [default: `null`]
  instructions jsonb [default: `null`]
  created_by_user_id integer [default: `null`]

  indexes {
    (name, created_by_user_id) [name: 'exercise_name_user', unique]
  }
}

table app.food_favorites {
  user_id integer [not null]
  food_id integer [not null]

  indexes {
    (user_id, food_id) [pk]
  }
}

table app.food_nutrients {
  food_serving_id integer [not null]
  nutrient_id integer [not null]
  amount numeric [not null]

  indexes {
    (food_serving_id, nutrient_id) [pk]
  }
}

table app.food_servings {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  food_id integer [not null]
  kind varchar [not null]
  label varchar(64) [not null]
  quantity numeric [not null, default: '1']
  basis_grams numeric [default: `null`]
  has_own_nutrition boolean [not null]
  origin varchar [not null]
  user_modified boolean [not null, default: false]
  sort_order integer [not null, default: 0]
  deleted_at timestamp [default: `null`]

  indexes {
    food_id [name: 'food_one_weight_serving', unique]
    
    
    
    
  }
}

table app.food_sources {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  key varchar [not null]
  name varchar(255) [not null]
  license_notice text [default: `null`]
  attribution_required boolean [not null, default: false]
  persistable boolean [not null, default: true]

  indexes {
    key [name: 'food_source_key_unique', unique]
  }
}

table app.food_usage_stats {
  user_id integer [not null]
  food_id integer [not null]
  log_count integer [not null, default: 0]
  last_logged_at timestamp [not null]
  hidden_at timestamp

  indexes {
    (user_id, food_id) [pk]
  }
}

table app.foods {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  name varchar(255) [not null]
  brand varchar(255) [default: `null`]
  created_by_user_id integer [default: `null`]
  source_id integer [default: `null`]
  external_id varchar(255) [default: `null`]
  barcode varchar(64) [default: `null`]
  forked_from_food_id integer [default: `null`]
  is_verified boolean [not null, default: false]
  deleted_at timestamp [default: `null`]

  indexes {
    barcode [name: 'food_catalog_barcode_unique', unique]
    (source_id, external_id) [name: 'food_catalog_external_unique', unique]
    (created_by_user_id, source_id, external_id) [name: 'food_owned_external_unique', unique]
    (created_by_user_id, deleted_at) [name: 'food_owner_live']
  }
}

table app.goal_profile_targets {
  profile_id integer [not null]
  nutrient_id integer [not null]
  amount numeric [not null]
  direction varchar [not null]
  ratio_percent numeric [default: `null`]

  indexes {
    (profile_id, nutrient_id) [pk]
  }
}

table app.goal_profiles {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  user_id integer [not null]
  name varchar(255) [not null]
  input_mode varchar [not null]
  calories numeric [default: `null`]
  is_default boolean [not null, default: false]
  deleted_at timestamp [default: `null`]

  indexes {
    user_id [name: 'goal_profile_one_default', unique]
  }
}

table app.import_jobs {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  user_id integer [not null]
  source varchar [not null]
  status varchar [not null, default: 'queued']
  file_count integer [not null]
  payload jsonb [not null]
  result jsonb [default: `null`]
  error text [default: `null`]
}

table app.meal_containers {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  user_id integer [not null]
  name varchar(64) [not null]
  sort_order integer [not null]
  is_archived boolean [not null, default: false]

  indexes {
    (user_id, name) [name: 'meal_container_user_name_unique', unique]
  }
}

table app.muscles {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  name varchar(255) [not null]
  body_part_id integer [not null]

  indexes {
    name [name: 'muscle_name', unique]
  }
}

table app.nutrients {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  key varchar(64) [not null]
  name varchar(255) [not null]
  unit varchar [not null]
  is_macro boolean [not null, default: false]
  default_direction varchar [not null, default: 'target']
  sort_order integer [not null]

  indexes {
    key [name: 'nutrient_key_unique', unique]
  }
}

table app.program_phases {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  program_id integer [not null]
  name varchar(255) [not null]
  sort_order integer [not null]
  week_start integer [not null]
  week_end integer [not null]
}

table app.program_workouts {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  phase_id integer [not null]
  template_id integer [default: `null`]
  name varchar(255) [not null]
  day_of_week integer [default: `null`]
  week_number integer [not null]
  sort_order integer [not null]
}

table app.programs {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  name varchar(255) [not null]
  description text [default: `null`]
  image_url varchar(255) [default: `null`]
  total_weeks integer [not null]
  created_by_user_id integer [default: `null`]
}

table app.recipe_ingredients {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  recipe_id integer [not null]
  food_id integer [not null]
  food_serving_id integer [not null]
  quantity numeric [not null]
  unit_label varchar(64) [not null]
  grams_resolved numeric [default: `null`]
  sort_order integer [not null]
}

table app.recipes {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  user_id integer [not null]
  name varchar(255) [not null]
  servings numeric [not null]
  serving_name varchar(64) [not null]
  finished_weight_g numeric [default: `null`]
  notes text [default: `null`]
  deleted_at timestamp [default: `null`]
}

table app.saved_meal_items {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  saved_meal_id integer [not null]
  food_id integer [not null]
  food_serving_id integer [not null]
  quantity numeric [not null]
  unit_label varchar(64) [not null]
  grams_resolved numeric [default: `null`]
  sort_order integer [not null]
}

table app.saved_meals {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  user_id integer [not null]
  name varchar(255) [not null]
  deleted_at timestamp [default: `null`]
}

table app.search_outbox {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  entity varchar(32) [not null]
  entity_id integer [not null]
  op varchar [not null]
  processed_at timestamp [default: `null`]

  indexes {
    id [name: 'search_outbox_pending']
  }
}

table app.user_program_enrollments {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  user_id integer [not null]
  program_id integer [not null]
  start_date date [not null]
  status varchar [not null]
}

table app.user_program_workout_completions {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  enrollment_id integer [not null]
  program_workout_id integer [not null]
  session_id integer [default: `null`]
  completion_percent integer [not null, default: 100]
  completed_at timestamp [not null]

  indexes {
    (enrollment_id, program_workout_id) [name: 'enrollment_workout_unique', unique]
  }
}

table app.user_tracked_nutrients {
  user_id integer [not null]
  nutrient_id integer [not null]
  sort_order integer [not null]

  indexes {
    (user_id, nutrient_id) [pk]
  }
}

table app.users {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  email varchar(255) [not null]
  name varchar(255) [not null]
  age integer [not null]
  sex varchar [default: `null`]
  avatar_url varchar(255) [default: `null`]
  is_active boolean [default: true]
  password varchar(255)
  week_start smallint [not null, default: 1]

  indexes {
    email [name: 'users_email_unique', unique]
    
  }
}

table app.workout_entries {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  session_id integer [not null]
  exercise_id integer [not null]
  sort_order integer [not null]
  entry_type varchar [not null]
  duration_seconds integer [default: `null`]
  distance_meters numeric [default: `null`]
  calories integer [default: `null`]
  avg_pace numeric [default: `null`]
  notes text [default: `null`]
}

table app.workout_sessions {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  user_id integer [not null]
  template_id integer [default: `null`]
  name varchar(255) [default: `null`]
  started_at timestamp [not null]
  completed_at timestamp [default: `null`]
  notes text [default: `null`]
}

table app.workout_sets {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  entry_id integer [not null]
  set_number integer [not null]
  weight numeric [not null]
  reps integer [not null]
  rpe integer [default: `null`]
}

table app.workout_template_entries {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  template_id integer [not null]
  exercise_id integer [not null]
  sort_order integer [not null]
  entry_type varchar [not null]
  target_sets integer [default: `null`]
  target_reps integer [default: `null`]
  target_weight numeric [default: `null`]
  target_duration_seconds integer [default: `null`]
  target_distance_meters numeric [default: `null`]
}

table app.workout_templates {
  id integer [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [default: `now()`]
  user_id integer [not null]
  name varchar(255) [not null]
  description text [default: `null`]
}

