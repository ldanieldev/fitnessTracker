  target_sets integer [default: `null`]
  target_low numeric [default: `null`]
  target_high numeric [default: `null`]
  target_weight numeric [default: `null`]
  superset_group smallint [default: `null`]
  optional boolean [not null, default: false]
  rest_seconds integer [default: `null`]

  indexes {
    exercise_id [name: 'workout_entry_exercise']
  }
}

