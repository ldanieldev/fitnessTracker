  external_id varchar(128) [default: `null`]
  created_by_user_id integer [default: `null`]
  deleted_at timestamp [default: `null`]

  indexes {
    external_id [name: 'exercise_external_id', unique]
    created_by_user_id [name: 'exercise_user_name', unique]
    (created_by_user_id, deleted_at) [name: 'exercise_owner_live']
  }
}

table app.food_favorites {
