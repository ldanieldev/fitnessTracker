ref auth_providers_user_id_users_id_fk: app.auth_providers.user_id > app.users.id [delete: cascade, update: no action]

ref diary_day_targets_day_id_diary_days_id_fk: app.diary_day_targets.day_id > app.diary_days.id [delete: cascade, update: no action]

