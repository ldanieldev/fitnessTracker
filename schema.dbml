  name varchar(64) [not null]
  color varchar(32) [not null]
  sort_order smallint [not null, default: 0]
  deleted_at timestamp [default: `null`]

  indexes {
    key [name: 'exercise_category_shared_key', unique]
    user_id [name: 'exercise_category_user_name', unique]
  }
}

table app.exercise_category_prefs {
